{
	"include": [
		"/etc/nixos/apps/waybar/Modules",
		"/etc/nixos/apps/waybar/ModulesWorkspaces",
		"/etc/nixos/apps/waybar/ModulesCustom",
		"/etc/nixos/apps/waybar/ModulesGroups",
		"/etc/nixos/apps/waybar/UserModules",
	],
	"layer": "top",
	//"mode": "dock",
	"exclusive": true,
	"passthrough": false,
	"position": "bottom",
	"spacing": 5,
	"fixed-center": true,
	"ipc": true,
	"margin-left": 5,
	"margin-right": 5,
	"margin-top": 0,
	"modules-left": [
		"clock#5",
		"mpris",
		"tray",
		"group/notify"
	],
	"modules-center": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"pulseaudio#1",
		"backlight#2",
		"power-profiles-daemon",
		"battery"
	],
}