/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* Ja KooLit - Default 

* All main themes or configs are located in /etc/nixos/apps/rofi/themes/
* If you want to edit the config, that is where you should edit NOT here 

* To load a new theme, manually edit the file path below or choose desired theme via rofi theme selector (choose via app menu)

* Alternative way to Load (preferred) own cooked by Ja 
* SUPER CTRL R - Choose style & SUPER CTRL SHIFT R 

* TIPS 
* If you have edited a config, rename it with a unique name. During update, the contents of 
* /etc/nixos/apps/rofi/themes/ will be replaced. */

/* ---- Global Configuration Fonts ---- */
@import "/etc/nixos/apps/rofi/0-shared-fonts.rasi"

/* note: Main themes in /etc/nixos/apps/rofi/themes */
/* You can manually change here or you can use rofi theme selector SUPER SHIFT E */


@theme "/etc/nixos/apps/rofi/themes/KooL_style-4.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-4.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_LonerOrZ.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-1.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-2-Dark.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-1.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-5.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-7.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-6.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-5.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-5.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-5.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-13-Vertical.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-13-Vertical.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-12-TOP-Docu.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-11-Win11-list-light.rasi"
@theme "/etc/nixos/apps/rofi/themes/KooL_style-11-Win11-list-dark.rasi"
